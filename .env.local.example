# Copy this file to .env.local and fill in each department's Supabase
# project URL + anon (publishable) key — Supabase dashboard →
# Project Settings → API.
#
# One frontend, one Supabase project per department. See
# lib/supabase/departments.ts and README.md ("Multi-department setup")
# for how these are used and how to add another department later.

# ── Department of Management Studies (DMS) ──
NEXT_PUBLIC_SUPABASE_URL_DMS=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DMS=

# ── Department of Multimedia & Mass Communication (DMMC) ──
NEXT_PUBLIC_SUPABASE_URL_DMMC=
NEXT_PUBLIC_SUPABASE_ANON_KEY_DMMC=
